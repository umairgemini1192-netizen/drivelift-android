<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Recessed glass app dock container matching GlassWidgetStyle (GlassWidgetLevel.Dock). -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="315"
                android:endColor="@color/cockpit_glass_fill_bottom"
                android:startColor="@color/cockpit_glass_dock_fill_top" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:centerX="0.12"
                android:centerY="0.12"
                android:endColor="#00000000"
                android:gradientRadius="140dp"
                android:startColor="@color/cockpit_glass_highlight_top_left"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="@color/cockpit_glass_tile_stroke" />
        </shape>
    </item>
</layer-list>
