<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Translucent deep navy/charcoal gradient matching GlassWidgetStyle. -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:angle="315"
                android:endColor="@color/cockpit_glass_fill_bottom"
                android:startColor="@color/cockpit_glass_fill_top" />
        </shape>
    </item>
    <!-- Soft top-left highlight catch. -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:centerX="0.14"
                android:centerY="0.12"
                android:endColor="#00000000"
                android:gradientRadius="220dp"
                android:startColor="@color/cockpit_glass_highlight_top_left"
                android:type="radial" />
        </shape>
    </item>
    <!-- 1dp hairline border. -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <stroke
                android:width="1dp"
                android:color="@color/cockpit_glass_card_stroke" />
        </shape>
    </item>
</layer-list>
