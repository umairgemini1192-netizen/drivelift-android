<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Recessed translucent well with top-left highlight and concentric 16dp corners. -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="315"
                android:endColor="@color/cockpit_glass_fill_bottom"
                android:startColor="@color/cockpit_glass_well_fill" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:centerX="0.12"
                android:centerY="0.12"
                android:endColor="#00000000"
                android:gradientRadius="120dp"
                android:startColor="@color/cockpit_glass_highlight_top_left"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/cockpit_glass_well_stroke" />
        </shape>
    </item>
</layer-list>
