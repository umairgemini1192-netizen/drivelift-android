<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextClock
            android:id="@+id/cockpit_widget_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:format12Hour="hh:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/cockpit_on_surface"
            android:textFontWeight="800"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextClock
            android:id="@+id/cockpit_widget_ampm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/cockpit_widget_pill_inactive_bg"
            android:fontFeatureSettings="tnum"
            android:format12Hour="a"
            android:format24Hour=""
            android:includeFontPadding="false"
            android:paddingHorizontal="5dp"
            android:paddingVertical="1dp"
            android:singleLine="true"
            android:textAllCaps="true"
            android:textColor="@color/cockpit_tertiary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextClock
        android:id="@+id/cockpit_widget_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFeatureSettings="tnum"
        android:format12Hour="EEE &#183; MMM d"
        android:format24Hour="EEE &#183; MMM d"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textColor="@color/cockpit_on_surface_variant"
        android:textSize="12sp" />
</LinearLayout>
