<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cockpit_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/cockpit_widget_shell_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/cockpit_widget_card_bg" />

    <LinearLayout
        android:id="@+id/cockpit_widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="7dp">

        <!-- Zone 1: Clock + Date (Left) | Status Badge aligned directly on the Clock Row (Right) -->
        <LinearLayout
            android:id="@+id/cockpit_widget_clock_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cockpit_widget_clock_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextClock
                    android:id="@+id/cockpit_widget_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:format12Hour="hh:mm"
                    android:format24Hour="HH:mm"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/cockpit_on_surface"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextClock
                    android:id="@+id/cockpit_widget_ampm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/cockpit_widget_pill_inactive_bg"
                    android:fontFeatureSettings="tnum"
                    android:format12Hour="a"
                    android:format24Hour=""
                    android:includeFontPadding="false"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="1dp"
                    android:singleLine="true"
                    android:textAllCaps="true"
                    android:textColor="@color/cockpit_primary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextClock
                    android:id="@+id/cockpit_widget_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:fontFeatureSettings="tnum"
                    android:format12Hour="EEE &#183; MMM d"
                    android:format24Hour="EEE &#183; MMM d"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/cockpit_on_surface_variant"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cockpit_widget_status_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/cockpit_widget_status_ready_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp">

                <ImageView
                    android:id="@+id/cockpit_widget_status_dot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@null"
                    android:src="@drawable/cockpit_widget_dot"
                    android:tint="@color/cockpit_tertiary" />

                <TextView
                    android:id="@+id/cockpit_widget_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="READY"
                    android:textColor="@color/cockpit_tertiary"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Zone 2: Alarm Pill (Left) | Dual Balanced Telemetry Gauges (Right) -->
        <LinearLayout
            android:id="@+id/cockpit_widget_telemetry_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cockpit_widget_alarm_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/cockpit_widget_well_bg"
                android:gravity="start|center_vertical"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/cockpit_alarm_icon"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_cockpit_alarm"
                        android:tint="@color/cockpit_primary" />

                    <TextView
                        android:id="@+id/cockpit_alarm_time_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFeatureSettings="tnum"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="No alarm set"
                        android:textColor="@color/cockpit_on_surface"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <Chronometer
                    android:id="@+id/cockpit_alarm_chronometer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:countDown="true"
                    android:ellipsize="none"
                    android:fontFeatureSettings="tnum"
                    android:format="Rings in %s"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/cockpit_primary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/cockpit_alarm_static_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="none"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/cockpit_primary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal">

                <!-- Battery Telemetry Column -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/cockpit_widget_battery_gauge"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="Battery level"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/cockpit_widget_battery_current"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFeatureSettings="tnum"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="-- mA"
                        android:textColor="@color/cockpit_secondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/cockpit_widget_battery_charge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFeatureSettings="tnum"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="-- mAh"
                        android:textColor="@color/cockpit_on_surface_variant"
                        android:textSize="9sp" />
                </LinearLayout>

                <!-- RAM Telemetry Column -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/cockpit_widget_ram_gauge"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="RAM usage"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/cockpit_widget_ram_used"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFeatureSettings="tnum"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="--"
                        android:textColor="@color/cockpit_primary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/cockpit_widget_ram_free"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFeatureSettings="tnum"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="RAM"
                        android:textColor="@color/cockpit_on_surface_variant"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Zone 3: 3-Column Sculptural Control Deck (Drop, Torch, Island) -->
        <LinearLayout
            android:id="@+id/cockpit_widget_controls_row"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Drop / Stop Tile -->
            <FrameLayout
                android:id="@+id/cockpit_widget_btn_drop"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/cockpit_widget_drop_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="4dp">

                    <ImageView
                        android:id="@+id/cockpit_widget_drop_icon"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_cockpit_devices" />

                    <TextView
                        android:id="@+id/cockpit_widget_drop_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="Drop"
                        android:textColor="@color/cockpit_on_surface"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- Torch Tile -->
            <FrameLayout
                android:id="@+id/cockpit_widget_btn_torch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/cockpit_widget_torch_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="4dp">

                    <ImageView
                        android:id="@+id/cockpit_widget_torch_icon"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_cockpit_torch_off" />

                    <TextView
                        android:id="@+id/cockpit_widget_torch_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="Torch"
                        android:textColor="@color/cockpit_on_surface"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- Island Tile -->
            <FrameLayout
                android:id="@+id/cockpit_widget_btn_island"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/cockpit_widget_island_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="4dp">

                    <ImageView
                        android:id="@+id/cockpit_widget_island_icon"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_cockpit_tile" />

                    <TextView
                        android:id="@+id/cockpit_widget_island_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="Island"
                        android:textColor="@color/cockpit_on_surface"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Zone 4: Recessed App Dock with Pager Broadcast Buttons -->
        <FrameLayout
            android:id="@+id/cockpit_widget_dock_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/cockpit_widget_dock_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="6dp"
                android:paddingVertical="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/cockpit_widget_btn_prev"
                        android:layout_width="28dp"
                        android:layout_height="40dp"
                        android:contentDescription="Previous pinned apps"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="&#8249;"
                        android:textColor="@color/cockpit_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/cockpit_widget_app_0"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="2dp">

                        <ImageView
                            android:id="@+id/cockpit_widget_app_icon_0"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />

                        <TextView
                            android:id="@+id/cockpit_widget_app_label_0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="@color/cockpit_on_surface"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cockpit_widget_app_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="2dp">

                        <ImageView
                            android:id="@+id/cockpit_widget_app_icon_1"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />

                        <TextView
                            android:id="@+id/cockpit_widget_app_label_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="@color/cockpit_on_surface"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cockpit_widget_app_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="2dp">

                        <ImageView
                            android:id="@+id/cockpit_widget_app_icon_2"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />

                        <TextView
                            android:id="@+id/cockpit_widget_app_label_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="@color/cockpit_on_surface"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cockpit_widget_app_3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="2dp">

                        <ImageView
                            android:id="@+id/cockpit_widget_app_icon_3"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />

                        <TextView
                            android:id="@+id/cockpit_widget_app_label_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="@color/cockpit_on_surface"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/cockpit_widget_btn_next"
                        android:layout_width="28dp"
                        android:layout_height="40dp"
                        android:contentDescription="Next pinned apps"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="&#8250;"
                        android:textColor="@color/cockpit_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cockpit_widget_pager_dots_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/cockpit_widget_dot_0"
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:contentDescription="@null"
                        android:src="@drawable/cockpit_widget_dot" />

                    <ImageView
                        android:id="@+id/cockpit_widget_dot_1"
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@null"
                        android:src="@drawable/cockpit_widget_dot" />

                    <ImageView
                        android:id="@+id/cockpit_widget_dot_2"
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@null"
                        android:src="@drawable/cockpit_widget_dot" />

                    <ImageView
                        android:id="@+id/cockpit_widget_dot_3"
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@null"
                        android:src="@drawable/cockpit_widget_dot" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
